 14 files changed, 42 insertions(+), 14 deletions(-)

diff --git a/opt/nvidia/video-codec-sdk/13.0.37/Samples/AppDecode/AppDecD3D/CMakeLists.txt b/opt/nvidia/video-codec-sdk/13.0.37/Samples/AppDecode/AppDecD3D/CMakeLists.txt
index d55f546..4472eb8 100644
--- a/opt/nvidia/video-codec-sdk/13.0.37/Samples/AppDecode/AppDecD3D/CMakeLists.txt
+++ b/opt/nvidia/video-codec-sdk/13.0.37/Samples/AppDecode/AppDecD3D/CMakeLists.txt
@@ -87,7 +87,9 @@ if(CUDAToolkit_FOUND AND CUDAToolkit_NVCC_EXECUTABLE)
     enable_language(CUDA)
     add_executable(${PROJECT_NAME} ${APP_SOURCES} ${NV_DEC_SOURCES} ${NV_DEC_HDRS} ${NV_ENC_CUDA_UTILS})
     set_property(TARGET ${PROJECT_NAME} PROPERTY CUDA_STANDARD 11)
-    if(NVCODEC_CUDA_VERSION_13_OR_GREATER)
+    if(DEFINED CMAKE_CUDA_ARCHITECTURES)
+        # Use the architectures selected by the build configuration
+    elseif(NVCODEC_CUDA_VERSION_13_OR_GREATER)
         set_property(TARGET ${PROJECT_NAME} PROPERTY CUDA_ARCHITECTURES "75")
     else()
         set_property(TARGET ${PROJECT_NAME} PROPERTY CUDA_ARCHITECTURES "50")
